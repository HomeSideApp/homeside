# Playwright E2E artifacts. These are SENSITIVE: traces, screenshots, the HTML
# report and session state can contain live cookies, one-time URLs and account
# data. Never commit them.
/tests/e2e/.artifacts/
/test-results/
/playwright-report/
/playwright/.auth/
*.storageState.json
/tests/e2e/.secrets*
# Package-published SaaS pages: generated by `php artisan saas:install --pages`
# from the optional homeside/saas module. Never commit them — they import
# Wayfinder routes that only exist while the module is installed.
/resources/js/pages/saas
# Package-published locale fragments: generated by `php artisan saas:install`
# from the optional homeside/saas module. Never commit them — they are
# installation artifacts, merged at build time by resources/js/i18n.ts.
/resources/js/locales/module-*.ts
